{
  "name": "face-to-emoji",
  "version": "1.0.0",
  "private": true,
  "description": "A static web app that reads facial movements in the browser and shows the closest matching emoji.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "postinstall": "node fetch-assets.mjs",
    "assets": "node fetch-assets.mjs",
    "dev": "vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node check-contrast.mjs && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
