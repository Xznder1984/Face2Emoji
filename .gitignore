node_modules/
dist/
.DS_Store
*.log

# Nothing in this project needs a secret, and nothing ever should.
.env
.env.*
!.env.example

# Model runtime files are generated by `npm run assets` (postinstall) and are
# not committed. The MediaPipe WASM comes out of the installed npm package and
# the face model is downloaded, because its licence is not stated upstream.
# The one exception is the UMD bundle, which the worker loads with importScripts
# and which has to be served from this origin.
public/mediapipe/*
!public/mediapipe/vision_bundle.js

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Python
__pycache__/
*.pyc
